{
    "name": "togul/laravel-sdk",
    "description": "Laravel integration for Togul Feature Flag Service",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "togul/php-sdk": "^3.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "open-feature/sdk": "^2.3"
    },
    "suggest": {
        "open-feature/sdk": "Registers Togul as the global OpenFeature provider (^2.3)"
    },
    "autoload": {
        "psr-4": {
            "Togul\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Togul\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Togul\\Laravel\\TogulServiceProvider"
            ],
            "aliases": {
                "Togul": "Togul\\Laravel\\Facades\\Togul"
            }
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit tests"
    }
}
